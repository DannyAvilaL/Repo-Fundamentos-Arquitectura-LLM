# Copia a .env: cp .env.example .env

# Proyecto de GCP donde corre el agente
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
GOOGLE_CLOUD_LOCATION=us-central1

# Usar Vertex AI (Gemini Enterprise Agent Platform) en vez de Google AI Studio directo
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Modelo a usar
ADK_MODEL=gemini-2.0-flash

# Autenticación: NO se pone API key aquí.
# Ejecuta en tu terminal antes de correr el agente:
#   gcloud auth application-default login
