# Copia a .env: cp .env.example .env

# API key de Gemini (Google AI Studio) — NUNCA la hardcodees en el código.
# Obtenla en https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu-api-key-aqui

# Modelo a usar
GEMINI_MODEL=gemini-2.0-flash

# Puerto local (Cloud Run inyecta PORT automáticamente en producción)
PORT=8080
