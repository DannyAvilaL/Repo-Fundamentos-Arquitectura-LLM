# Copie este archivo a .env y complete solo las API keys de los proveedores
# que vaya a probar con llamadas reales. Si deja una variable vacía o
# ausente, ese proveedor funcionará automáticamente en MODO_SIMULADO
# (ver proveedores.py) — el resto del pipeline (evaluación, costeo,
# checklist, registro) funciona igual sin necesidad de ninguna key.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama corre localmente; normalmente no requiere key, solo la URL del
# servidor local (ver ../ollama/GUIA_OLLAMA.md para instalarlo).
OLLAMA_BASE_URL=http://localhost:11434

# Orígenes permitidos por CORS para el frontend (Vite por defecto en 5173).
CORS_ORIGINS=http://localhost:5173
